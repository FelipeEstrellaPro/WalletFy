# Default rules for a Flutter/Dart project
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart
*.freezed.dart

# But keep the DB-related generated files
!lib/data/database/app_database.g.dart
!lib/data/database/daos/*.g.dart

# IDE
.idea/
.vscode/
*.iml
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# Windows runner
windows/runner/*.exe

# macOS
macos/Pods/
